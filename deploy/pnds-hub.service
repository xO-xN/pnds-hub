# /etc/systemd/system/pnds-hub.service — installed by install.sh /
# update.sh. Paths are bound to /opt/pnds-hub (the supported layout).
[Unit]
Description=PNDS telematic hub (Socket.IO relay)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/pnds-hub
EnvironmentFile=/opt/pnds-hub/hub.env
# /usr/bin/env resolves node from the manager's PATH, so any system
# install location (e.g. /usr/bin or /usr/local/bin) works.
ExecStart=/usr/bin/env node hub.js
Restart=always
RestartSec=2

# Sandboxing: the hub is stateless at runtime (journal logging only),
# so it runs as a transient user with a read-only view of the system.
DynamicUser=yes
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
